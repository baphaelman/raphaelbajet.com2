#!/bin/sh
# Every commit carries the Slop Zone's facts as of now (vite-project/scripts/slop-stats.mjs): the site is static, so a
# deploy shows what was last committed. If the script fails, the commit goes through with the old facts.
# Turned on with `git config core.hooksPath .githooks`.
# Stage from the top level: in a linked worktree git sets GIT_DIR for hooks, and a `git add` run from vite-project/
# would then take vite-project/ as the top and stage copies at the root.
cd "$(git rev-parse --show-toplevel)" || exit 0
if (cd vite-project && node scripts/slop-stats.mjs >/dev/null 2>&1); then
    git add vite-project/src/slopStats.json vite-project/scripts/slopSessions.json
else
    echo "slop-stats failed: committing the Slop Zone's old facts" >&2
fi
